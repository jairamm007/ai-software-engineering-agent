# ─── Application ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_software_engineering_agent
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_software_engineering_agent?schema=public"

# ─── Redis (optional, for distributed rate limiting) ─────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ─────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── OAuth — Google ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth — GitHub ─────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── GitHub Integration (Personal Access Token for API access) ──
# Users provide their own PAT via the app UI, not via env var.
# Required scopes: repo (full control of private repos)

# ─── GitHub Token Encryption ────────────────────────────────────
# 64-character hex string (32 bytes) for AES-256-GCM encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# ─── AI Provider Keys ──────────────────────────────────────────
# At least one provider key is required for the AI features to work.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Provider priority (comma-separated, first available wins)
LLM_PROVIDER_ORDER=gemini,groq,openrouter,openai,cerebras,together,mistral

# ─── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── Frontend ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ─── Error Tracking (Sentry) ───────────────────────────────────
SENTRY_DSN=

# ─── Logging ────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
