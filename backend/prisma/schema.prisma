generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Tables ───────────────────────────────────────────────

model user {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  bannerUrl     String?
  bio           String?
  role          String?
  suspended     Boolean   @default(false)
  linkedinUrl   String?
  githubUrl     String?
  portfolioUrl  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  session[]
  accounts  account[]
  repositories Repository[]
  conversations Conversation[]
  preferences UserPreference?
  ownedTeams Team[]
  teamMemberships TeamMember[]
  activities TeamActivity[]
  comments Comment[]
  githubIntegrations GitHubIntegration[]
  auditLogs AuditLog[]
  codeReviews CodeReview[]
  testReports TestReport[]
  supportMessages SupportMessage[]
}

model session {
  id           String   @id @default(cuid())
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                String  @id @default(cuid())
  accountId         String
  providerId        String
  userId            String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Application Tables ───────────────────────────────────────────────

model Repository {
  id         String    @id @default(cuid())
  name       String
  githubUrl  String
  localPath  String
  userId     String
  isFavorite Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  files  RepositoryFile[]
  teamShares TeamRepository[]
  docs Documentation[]
  codeReviews CodeReview[]
  testReports TestReport[]

  @@unique([githubUrl, userId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model RepositoryFile {
  id           String   @id @default(cuid())
  repositoryId String
  path         String
  extension    String
  size         Int

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  chunks     CodeChunk[]
  symbols    CodeSymbol[]

  @@index([repositoryId])
  @@index([repositoryId, extension])
}

model CodeChunk {
  id        String @id @default(cuid())
  fileId    String

  content   String

  startLine Int
  endLine   Int

  file RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model CodeSymbol {
  id        String @id @default(cuid())

  fileId    String

  name      String

  kind      String

  exported  Boolean

  file RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([name])

  @@index([kind])
}

// ─── Chat / Conversations ───────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  title          String
  userId         String
  repositoryId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([repositoryId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant" | "system"
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── User Preferences ─────────────────────────────────────────────

model UserPreference {
  id            String  @id @default(cuid())
  userId        String  @unique
  defaultModel  String  @default("gemini-2.5-flash")
  temperature   Float   @default(0.3)
  theme         String  @default("dark")
  accentColor   String  @default("violet")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Team Collaboration ───────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  slug        String   @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       user            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invitations TeamInvitation[]
  repositories TeamRepository[]
  activities  TeamActivity[]
  comments    Comment[]

  @@index([ownerId])
  @@index([slug])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member") // owner | admin | member | viewer
  joinedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      String   @default("member")
  invitedBy String
  status    String   @default("pending") // pending | accepted | rejected | expired
  expiresAt DateTime
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@unique([teamId, email])
}

model TeamRepository {
  id           String   @id @default(cuid())
  teamId       String
  repositoryId String
  sharedBy     String
  permission   String   @default("read") // read | write | admin
  sharedAt     DateTime @default(now())

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([teamId, repositoryId])
  @@index([teamId])
  @@index([repositoryId])
}

model TeamActivity {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  action    String   // invite_sent | member_joined | member_removed | repo_shared | comment_posted | role_changed
  details   String?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([teamId, createdAt(sort: Desc)])
}

model Comment {
  id             String   @id @default(cuid())
  teamId         String
  userId         String
  repositoryId   String?
  parentCommentId String?
  content        String
  mentions       String[] // array of userIds mentioned
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([repositoryId])
  @@index([userId])
  @@index([teamId, createdAt(sort: Desc)])
}

// ─── GitHub Integration ───────────────────────────────────────────

model GitHubIntegration {
  id           String   @id @default(cuid())
  userId       String
  githubUrl    String
  token        String   // encrypted GitHub PAT
  isActive     Boolean  @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repos        GitHubIntegrationRepository[]

  @@unique([userId, githubUrl])
  @@index([userId])
}

model GitHubIntegrationRepository {
  id              String   @id @default(cuid())
  integrationId   String
  owner           String
  name            String
  fullName        String
  description     String?
  defaultBranch   String   @default("main")
  isPrivate       Boolean  @default(false)
  language        String?
  starsCount      Int      @default(0)
  forksCount      Int      @default(0)
  openIssuesCount Int      @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  integration GitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, owner, name])
  @@index([integrationId])
}

// ─── Admin Models ─────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // user_login | user_logout | user_created | user_deleted | user_updated | repo_deleted | admin_action | settings_changed | password_reset | role_changed | session_revoked
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user user? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info | warning | announcement
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt(sort: Desc)])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@index([key])
}

// ─── Documentation Management ─────────────────────────────────────

model Documentation {
  id             String   @id @default(cuid())
  repositoryId   String
  title          String
  content        String?
  format         String   @default("markdown") // markdown | pdf
  status         String   @default("completed") // generating | completed | failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([createdAt(sort: Desc)])
}

// ─── Code Review Management ───────────────────────────────────────

model CodeReview {
  id             String   @id @default(cuid())
  repositoryId   String
  userId         String?
  status         String   @default("completed") // pending | running | completed | failed
  summary        String?
  issuesFound    Int      @default(0)
  criticalCount  Int      @default(0)
  warningCount   Int      @default(0)
  infoCount      Int      @default(0)
  reportData     String?  // JSON string of detailed findings
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       user?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// ─── Testing Management ───────────────────────────────────────────

model TestReport {
  id             String   @id @default(cuid())
  repositoryId   String
  userId         String?
  status         String   @default("completed") // pending | running | completed | failed
  totalTests     Int      @default(0)
  passedTests    Int      @default(0)
  failedTests    Int      @default(0)
  skippedTests   Int      @default(0)
  coverage       Float?
  reportData     String?  // JSON string of test details
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       user?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// ─── Support Center ───────────────────────────────────────────────

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String?
  subject   String
  message   String
  category  String   @default("feedback") // feedback | bug | feature | other
  status    String   @default("open")     // open | in_progress | resolved | closed
  priority  String   @default("normal")   // low | normal | high | urgent
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// ─── Backup & Recovery ────────────────────────────────────────────

model BackupRecord {
  id        String   @id @default(cuid())
  filename  String
  size      BigInt   @default(0)
  status    String   @default("completed") // creating | completed | failed
  type      String   @default("full")     // full | incremental
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
